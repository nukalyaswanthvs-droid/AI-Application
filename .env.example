# ==========================================
# COLLEGE KNOWLEDGE AI - Environment Configuration
# ==========================================

# 1. Ollama Configuration (Local Generative AI)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_EMBED_MODEL=nomic-embed-text

# 2. Supabase / PostgreSQL Configuration (Vector Database)
# Enter your Supabase project URL and anon/service_role API key:
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-api-key

# Direct PostgreSQL connection string (Found in Supabase: Project Settings -> Database -> Connection URI)
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres

# 3. Vector Embedding Settings
# Default is 768 (dimension for nomic-embed-text). Change if using another embed model (e.g. 3072 for llama3.2)
EMBEDDING_DIMENSION=768

# 4. RAG Retrieval Parameters
CHUNK_SIZE=800
CHUNK_OVERLAP=150
TOP_K_CHUNKS=4
SIMILARITY_THRESHOLD=0.35

# 5. Server Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=5173
